# 默认模拟模式无需任何凭据。
MOCK_MODE=true
PORT=8000
SERVER_INTERNAL_URL=http://localhost:8000
APP_PORT=8787
HTTPS_PORT=8443
ADMIN_URL=http://localhost:8001
SUPPORT_URL=http://localhost:8002
ADMIN_ADDRESS=http://admin.localhost
SUPPORT_ADDRESS=http://support.localhost
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
MEDIA_DIR=.media
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333

# 生产环境必须设置为随机 32 字节的 base64url 或 64 位十六进制值。
# 生成命令：openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
APP_ENCRYPTION_KEY=

# 真实模型模式：改为 false，并填写兼容 OpenAI Chat Completions API 的凭据。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
